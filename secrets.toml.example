# Copy this file to secrets.toml (local) and also paste the same
# values into Streamlit Cloud: App settings → Secrets.
# Never commit the real secrets.toml.

TELEGRAM_BOT_TOKEN = "123456:ABC-your-bot-token-from-BotFather"
data_backend = "gsheets"   # gsheets | sql | csv

# --- Option A: Google Sheets via st.connection ---
# 1. Create a Google Cloud service account.
# 2. Enable Google Sheets API + Google Drive API.
# 3. Share your spreadsheet with the service account email (Editor).
# 4. First row of the sheet must be the column headers from complaints.csv.

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit#gid=0"
worksheet = "complaints"
type = "service_account"
project_id = "your-gcp-project"
private_key_id = "xxxxxxxx"
private_key = """-----BEGIN PRIVATE KEY-----
REPLACE_ME
-----END PRIVATE KEY-----
"""
client_email = "unionstudent@your-gcp-project.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/unionstudent%40your-gcp-project.iam.gserviceaccount.com"

# --- Option B: SQL database via st.connection ---
# Uncomment and set data_backend = "sql"
# [connections.complaints_db]
# url = "postgresql://USER:PASSWORD@HOST:5432/unionstudent"
# dialect = "postgresql"
